# Copy to web/.env.local (never committed). Nothing here is a secret: Google APIs use Application
# Default Credentials (`gcloud auth application-default login` locally, the Cloud Run service account
# in production), and Firebase web config values are public by design.

# --- Firebase web app (Project settings → Your apps → Web app); compiled into the page ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=
GCP_REGION=us-central1
FIRESTORE_DATABASE=likeness
GCS_BUCKET=
KMS_KEYRING=likeness
KMS_PHOTO_KEY=photos
KMS_RECEIPT_KEY=receipts
KMS_RECEIPT_KEY_VERSION=1

# --- Models (Vertex AI) ---
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_FILTER_MODEL=gemini-3.5-flash-lite
VEO_MODEL=veo-3.1-lite-generate-001

# --- Guards ---
# Face match: best cosine similarity of a live frame to the channel avatar (YuNet + AuraFace).
FACE_MATCH_THRESHOLD=0.5
# Video quality gate: a sampled frame's face must match the creator's references at or above this
# (generated frames score lower than live photos; see lib/server/gate.ts for the calibration).
GATE_FACE_MATCH_THRESHOLD=0.35
# Creative assistant ("Write it for me") calls per UTC day, site-wide (text only, fractions of a cent).
ASSISTS_PER_DAY=300
# Site-wide renders per UTC day, and videos per UTC day (Veo costs about $0.03 per second at 720p,
# about $0.05 at 1080p; a failed quality gate retries once, so a video can cost two Veo calls).
RENDERS_PER_DAY=40
VIDEOS_PER_DAY=10
# Per brand, per UTC day, while the app is public (a video counts as one of the ads).
BRAND_RENDERS_PER_DAY=3
BRAND_VIDEOS_PER_DAY=1
# Set to 1 to always use the free ffmpeg fallback instead of Veo.
VEO_DISABLED=0
# Local only: an ffmpeg binary (the container has one).
FFMPEG_PATH=

# --- C2PA (TEST certificate from scripts/c2pa-testcert.sh; in production via Secret Manager) ---
C2PA_CERT_FILE=../.secrets/c2pa/signer.pem
C2PA_KEY_FILE=../.secrets/c2pa/signer.key
